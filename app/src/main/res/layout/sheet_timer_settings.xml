<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0B0D12"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="28dp"
    android:paddingEnd="12dp"
    android:paddingBottom="36dp">

    <TextView style="@style/Caption" android:text="Presets · minutes" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <EditText android:id="@+id/p1" style="@style/PresetEdit" />
        <EditText android:id="@+id/p2" style="@style/PresetEdit" android:layout_marginStart="10dp" />
        <EditText android:id="@+id/p3" style="@style/PresetEdit" android:layout_marginStart="10dp" />
    </LinearLayout>

    <LinearLayout style="@style/Row" android:layout_marginTop="28dp">
        <TextView style="@style/RowLabel" android:text="Sound" />
        <TextView android:id="@+id/txt_sound" style="@style/RowValue" android:text="Soft chime" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15181F" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
        <TextView style="@style/RowLabel" android:text="Volume" />
        <TextView android:id="@+id/txt_volume" style="@style/RowValue" android:text="70%" />
    </LinearLayout>
    <SeekBar
        android:id="@+id/seek_volume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:progressTint="#F2F4F8"
        android:progressBackgroundTint="#22262F"
        android:thumbTint="#F2F4F8" />

    <Button
        android:id="@+id/btn_done"
        style="@style/PrimaryButton"
        android:layout_marginTop="28dp"
        android:text="Done" />
</LinearLayout>

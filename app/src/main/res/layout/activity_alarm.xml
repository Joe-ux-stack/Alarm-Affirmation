<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/alarm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060B18">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="80dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/txt_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6:30"
            android:textColor="#F2F4F8"
            android:textSize="88sp"
            android:fontFeatureSettings="tnum"
            android:textStyle="bold"
            android:letterSpacing="-0.03" />

        <TextView
            android:id="@+id/txt_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Thursday"
            android:textColor="#8A93A8"
            android:textSize="14sp" />

        <com.whynotyou.alarm.OrbView
            android:id="@+id/orb"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="30dp" />

        <TextView
            android:id="@+id/txt_brief"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:lineSpacingExtra="10dp"
            android:text=""
            android:textColor="#F2F4F8"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ring_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <com.whynotyou.alarm.SwipeDismissView
            android:id="@+id/btn_dismiss"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:contentDescription="Swipe to stop"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/row_snooze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/btn_snooze_minus"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_secondary"
                android:contentDescription="Less"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_minus"
                android:tint="#C9D4FF" />
            <Button
            android:letterSpacing="0"
                android:id="@+id/btn_snooze"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                android:backgroundTint="#1C2541"
                android:text="Snooze 5 mins"
                android:textAllCaps="false"
                android:textColor="#F2F4F8"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="28dp" />
            <ImageButton
                android:id="@+id/btn_snooze_plus"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_secondary"
                android:contentDescription="More"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_plus"
                android:tint="#C9D4FF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

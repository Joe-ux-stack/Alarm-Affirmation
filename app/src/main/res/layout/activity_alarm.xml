<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="88dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/txt_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6:30"
            android:textColor="#F2F4F8"
            android:textSize="88sp"
            android:textStyle="bold"
            android:letterSpacing="-0.03" />

        <TextView
            android:id="@+id/txt_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Thursday"
            android:textColor="#7A8294"
            android:textSize="14sp" />

        <com.whynotyou.alarm.OrbView
            android:id="@+id/orb"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="64dp" />

        <TextView
            android:id="@+id/txt_brief"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:lineSpacingExtra="8dp"
            android:text=""
            android:textColor="#F2F4F8"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/txt_phone_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Phone down."
            android:textColor="#F2F4F8"
            android:textSize="32sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_dismiss"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_circle_dismiss"
            android:contentDescription="Stop"
            android:padding="34dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:tint="#F2F4F8" />

        <Button
            android:id="@+id/btn_main"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:backgroundTint="#F2F4F8"
            android:text="Stop"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="36dp" />

        <Button
            android:id="@+id/btn_snooze"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:backgroundTint="#15181F"
            android:text="Snooze 5 min"
            android:textAllCaps="false"
            android:textColor="#F2F4F8"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="32dp" />
    </LinearLayout>
</FrameLayout>

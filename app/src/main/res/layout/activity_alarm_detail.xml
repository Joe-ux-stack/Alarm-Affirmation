<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="48dp"
            android:paddingEnd="20dp"
            android:paddingBottom="140dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <com.whynotyou.alarm.WheelView android:id="@+id/wheel_h" android:layout_width="104dp" android:layout_height="200dp" />
                <com.whynotyou.alarm.WheelView android:id="@+id/wheel_m" android:layout_width="104dp" android:layout_height="200dp" />
                <com.whynotyou.alarm.WheelView android:id="@+id/wheel_ap" android:layout_width="80dp" android:layout_height="200dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:orientation="horizontal" />

            <TextView style="@style/Caption" android:layout_marginTop="36dp" android:text="Sound" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView style="@style/RowLabel" android:text="Volume" />
                    <TextView android:id="@+id/txt_volume" style="@style/RowValue" android:text="80%" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seek_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progressTint="#F2F4F8"
                    android:progressBackgroundTint="#22262F"
                    android:thumbTint="#F2F4F8" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="#15181F" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="Ramp up gently" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_ramp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15181F" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="Snooze" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_snooze" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15181F" />

            <TextView style="@style/Caption" android:layout_marginTop="36dp" android:text="After you stop it" />

            <LinearLayout style="@style/Row" android:layout_marginTop="4dp">
                <TextView style="@style/RowLabel" android:text="Message" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_message" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15181F" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="Read my day" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_brief" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15181F" />

            <LinearLayout android:id="@+id/row_voice" style="@style/Row" android:background="?android:attr/selectableItemBackground">
                <TextView style="@style/RowLabel" android:text="Voice" />
                <TextView android:id="@+id/txt_voice" style="@style/RowValue" android:text="Sky" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:src="@drawable/ic_chevron" android:tint="#7A8294" android:importantForAccessibility="no" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15181F" />

            <Button
                android:id="@+id/btn_delete"
                style="@style/TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="Delete alarm" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#000000"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">
        <Button
            android:id="@+id/btn_cancel"
            style="@style/OutlineButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Cancel" />
        <Button
            android:id="@+id/btn_save"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Save" />
    </LinearLayout>
</FrameLayout>

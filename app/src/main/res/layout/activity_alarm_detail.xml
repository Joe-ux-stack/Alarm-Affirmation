<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="72dp"
            android:paddingEnd="28dp"
            android:paddingBottom="140dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/txt_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="6:30"
                    android:textColor="#F2F4F8"
                    android:textSize="88sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.03" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="18dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/btn_am" style="@style/AmPm" android:text="am" />
                    <TextView android:id="@+id/btn_pm" style="@style/AmPm" android:layout_marginStart="6dp" android:text="pm" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal" />

            <TextView style="@style/Caption" android:layout_marginTop="36dp" android:text="Sound" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView style="@style/RowLabel" android:text="Volume" />
                    <TextView android:id="@+id/txt_volume" style="@style/RowValue" android:text="80%" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seek_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progressTint="#F5A524"
                    android:progressBackgroundTint="#22262F"
                    android:thumbTint="#F2F4F8" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="#15181F" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="Ramp up gently" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_ramp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15181F" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="Snooze" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_snooze" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15181F" />

            <TextView style="@style/Caption" android:layout_marginTop="36dp" android:text="After you stop it" />

            <LinearLayout style="@style/Row" android:layout_marginTop="4dp">
                <TextView style="@style/RowLabel" android:text="Message" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_message" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15181F" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="Read my day" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_brief" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15181F" />

            <Button
                android:id="@+id/btn_delete"
                style="@style/TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="Delete alarm" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#000000"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">
        <Button
            android:id="@+id/btn_cancel"
            style="@style/OutlineButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Cancel" />
        <Button
            android:id="@+id/btn_save"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Save" />
    </LinearLayout>
</FrameLayout>

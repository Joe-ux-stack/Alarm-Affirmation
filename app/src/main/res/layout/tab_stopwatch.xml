<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="80dp"
    android:paddingEnd="20dp"
    android:paddingBottom="120dp">

    <TextView
        android:id="@+id/sw_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="00:00.00"
        android:textColor="#F2F4F8"
        android:textSize="64sp"
        android:minHeight="104dp"
        android:gravity="center"
        android:fontFeatureSettings="tnum"
        android:textStyle="bold"
        android:letterSpacing="-0.03" />

    <TextView
        android:id="@+id/sw_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Stopwatch"
        android:textColor="#8A93A8"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/sw_laps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">
        <Button
            android:letterSpacing="0" android:id="@+id/sw_lap" style="@style/BigRoundOutline" android:text="Lap" />
        <Button
            android:letterSpacing="0" android:id="@+id/sw_start" style="@style/BigRoundAmber" android:layout_marginStart="48dp" android:text="Start" />
    </LinearLayout>
</LinearLayout>

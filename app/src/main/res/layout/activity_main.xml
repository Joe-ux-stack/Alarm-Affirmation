<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ALARM TAB -->
    <ScrollView
        android:id="@+id/tab_alarm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="88dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="56dp"
            android:paddingEnd="24dp"
            android:paddingBottom="100dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/txt_next"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="#7A8294"
                    android:textSize="13sp" />
                <ImageButton
                    android:id="@+id/btn_gear"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Messages and setup"
                    android:src="@drawable/ic_gear"
                    android:tint="#7A8294" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_amber"
                android:padding="14dp"
                android:text=""
                android:textColor="#F2F4F8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_crash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_amber"
                android:padding="14dp"
                android:text=""
                android:textColor="#F2F4F8"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/list_alarms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txt_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:gravity="center"
                android:text="No alarms"
                android:textColor="#3A3F4B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- TIMER TAB -->
    <include
        android:id="@+id/tab_timer"
        layout="@layout/tab_timer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- STOPWATCH TAB -->
    <include
        android:id="@+id/tab_stopwatch"
        layout="@layout/tab_stopwatch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/fab_add"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="108dp"
        android:background="@drawable/bg_circle_amber"
        android:contentDescription="Add alarm"
        android:src="@drawable/ic_plus"
        android:tint="#000000" />

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_gravity="bottom"
        android:background="#000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="14dp">
        <LinearLayout android:id="@+id/nav_alarm" style="@style/NavItem">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_alarm" android:tint="#F2F4F8" android:importantForAccessibility="no" />
            <TextView style="@style/NavLabel" android:text="Alarm" android:textColor="#F2F4F8" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_timer" style="@style/NavItem">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_timer" android:tint="#555B68" android:importantForAccessibility="no" />
            <TextView style="@style/NavLabel" android:text="Timer" android:textColor="#555B68" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_stopwatch" style="@style/NavItem">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_stopwatch" android:tint="#555B68" android:importantForAccessibility="no" />
            <TextView style="@style/NavLabel" android:text="Stopwatch" android:textColor="#555B68" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

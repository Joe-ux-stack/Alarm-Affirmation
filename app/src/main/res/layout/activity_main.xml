<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1320"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="48dp">

        <!-- Warning strip: only visible when a permission is missing -->
        <LinearLayout
            android:id="@+id/row_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card_amber"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/txt_warning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1 permission missing — the alarm may not fire"
                android:textColor="#F2F4F8"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fix"
                android:textColor="#F5A524"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXT WAKE-UP"
            android:textColor="#9AA3B5"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="None"
            android:textColor="#F2F4F8"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_next_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap below to set one"
            android:textColor="#9AA3B5"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_set_time"
            style="@style/PrimaryButton"
            android:layout_marginTop="16dp"
            android:text="Set wake-up time" />

        <Button
            android:id="@+id/btn_cancel"
            style="@style/SecondaryButton"
            android:text="Cancel alarm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="TOMORROW I WILL…"
            android:textColor="#9AA3B5"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_intention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@android:color/transparent"
            android:hint="one thing, read to you after the video"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLines="2"
            android:paddingVertical="8dp"
            android:textColor="#F2F4F8"
            android:textColorHint="#3A4458"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A3245" />

        <TextView
            android:id="@+id/txt_brief_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Calendar: not connected yet"
            android:textColor="#6B7488"
            android:textSize="12sp" />

        <!-- Video card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WAKE-UP VIDEO"
                android:textColor="#9AA3B5"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Bundled placeholder"
                android:textColor="#F2F4F8"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_video_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:10"
                android:textColor="#9AA3B5"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btn_preview"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Preview" />
                <Button
                    android:id="@+id/btn_pick_video"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="Change" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_reset_video"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:background="@android:color/transparent"
                android:text="Back to bundled clip"
                android:textAllCaps="false"
                android:textColor="#9AA3B5"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Test row -->
        <Button
            android:id="@+id/btn_test_1min"
            style="@style/SecondaryButton"
            android:layout_marginTop="24dp"
            android:text="Test: fire in 1 min, then lock the phone" />

        <TextView
            android:id="@+id/txt_status_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:text="✓ Phone is set up to wake you"
            android:textColor="#6B7488"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

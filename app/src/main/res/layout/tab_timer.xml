<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Picker state -->
    <LinearLayout
        android:id="@+id/timer_pick"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="12dp">
            <ImageButton
                android:id="@+id/timer_gear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Timer settings"
                android:src="@drawable/ic_gear"
                android:tint="#8A93A8" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout style="@style/PickerCol">
                <TextView style="@style/PickerLabel" android:text="Hours" />
                <com.whynotyou.alarm.WheelView android:id="@+id/np_h" style="@style/Picker" />
            </LinearLayout>
            <LinearLayout style="@style/PickerCol">
                <TextView style="@style/PickerLabel" android:text="Minutes" />
                <com.whynotyou.alarm.WheelView android:id="@+id/np_m" style="@style/Picker" />
            </LinearLayout>
            <LinearLayout style="@style/PickerCol">
                <TextView style="@style/PickerLabel" android:text="Seconds" />
                <com.whynotyou.alarm.WheelView android:id="@+id/np_s" style="@style/Picker" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/preset_1" style="@style/Preset" android:text="5 min" />
            <TextView android:id="@+id/preset_2" style="@style/Preset" android:layout_marginStart="10dp" android:text="10 min" />
            <TextView android:id="@+id/preset_3" style="@style/Preset" android:layout_marginStart="10dp" android:text="25 min" />
        </LinearLayout>

        <Button
            android:letterSpacing="0"
            android:id="@+id/timer_start"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="72dp"
            android:background="@drawable/bg_circle_amber"
            android:text="Start"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:elevation="10dp"
            android:outlineSpotShadowColor="#2D5BFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Running state -->
    <LinearLayout
        android:id="@+id/timer_run"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="80dp"
        android:paddingBottom="120dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/timer_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="23:00"
            android:textColor="#F2F4F8"
            android:textSize="88sp"
            android:fontFeatureSettings="tnum"
            android:textStyle="bold"
            android:letterSpacing="-0.03" />
        <TextView
            android:id="@+id/timer_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Timer"
            android:textColor="#8A93A8"
            android:textSize="14sp" />
        <com.whynotyou.alarm.OrbView
            android:id="@+id/timer_orb"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="30dp" />
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
            android:letterSpacing="0" android:id="@+id/timer_cancel" style="@style/BigRoundOutline" android:text="Cancel" />
            <Button
            android:letterSpacing="0" android:id="@+id/timer_pause" style="@style/BigRoundAmber" android:layout_marginStart="48dp" android:text="Pause" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

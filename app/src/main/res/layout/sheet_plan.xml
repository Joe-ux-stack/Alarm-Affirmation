<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0B0D12"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="28dp"
    android:paddingEnd="20dp"
    android:paddingBottom="36dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tomorrow I will"
        android:textColor="#7A8294"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/edit_intention"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:hint="one thing"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLines="2"
        android:paddingVertical="8dp"
        android:textColor="#F2F4F8"
        android:textColorHint="#3A3F4B"
        android:textSize="22sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22262F" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Tomorrow"
        android:textColor="#7A8294"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txt_calendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="6dp"
        android:text=""
        android:textColor="#F2F4F8"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txt_calendar_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:text="Read my calendar →"
        android:textColor="#F2F4F8"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_done"
        style="@style/PrimaryButton"
        android:layout_marginTop="28dp"
        android:text="Done" />
</LinearLayout>

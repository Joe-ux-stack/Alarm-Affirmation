<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060B18"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="48dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Permissions"
            android:textColor="#F2F4F8"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_box"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/row_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notifications"
                    android:textColor="#F2F4F8"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <ImageButton
                    android:id="@+id/info_notif"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Why"
                    android:padding="9dp"
                    android:src="@drawable/ic_info"
                    android:tint="#8A93A8" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <Button
            android:letterSpacing="0"
                    android:id="@+id/btn_notif"
                    style="@style/SmallPrimaryButton"
                    android:text="Allow" />
                <TextView
                    android:id="@+id/tick_notif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="✓"
                    android:textColor="#7FDB9C"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingEnd="8dp"
                android:text="So the alarm can appear on the lock screen."
                android:textColor="#8A93A8"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_box"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/row_exact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exact alarms"
                    android:textColor="#F2F4F8"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <ImageButton
                    android:id="@+id/info_exact"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Why"
                    android:padding="9dp"
                    android:src="@drawable/ic_info"
                    android:tint="#8A93A8" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <Button
            android:letterSpacing="0"
                    android:id="@+id/btn_exact"
                    style="@style/SmallPrimaryButton"
                    android:text="Allow" />
                <TextView
                    android:id="@+id/tick_exact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="✓"
                    android:textColor="#7FDB9C"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_exact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingEnd="8dp"
                android:text="So it fires at 6:30, not “sometime around then”."
                android:textColor="#8A93A8"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_box"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/row_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery"
                    android:textColor="#F2F4F8"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <ImageButton
                    android:id="@+id/info_battery"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Why"
                    android:padding="9dp"
                    android:src="@drawable/ic_info"
                    android:tint="#8A93A8" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <Button
            android:letterSpacing="0"
                    android:id="@+id/btn_battery"
                    style="@style/SmallPrimaryButton"
                    android:text="Allow" />
                <TextView
                    android:id="@+id/tick_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="✓"
                    android:textColor="#7FDB9C"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingEnd="8dp"
                android:text="Samsung puts sleeping apps to sleep otherwise. Also set Settings → Apps → Why Not You → Battery → Unrestricted."
                android:textColor="#8A93A8"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_box"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/row_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Show over other apps"
                    android:textColor="#F2F4F8"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <ImageButton
                    android:id="@+id/info_overlay"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Why"
                    android:padding="9dp"
                    android:src="@drawable/ic_info"
                    android:tint="#8A93A8" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <Button
            android:letterSpacing="0"
                    android:id="@+id/btn_overlay"
                    style="@style/SmallPrimaryButton"
                    android:text="Allow" />
                <TextView
                    android:id="@+id/tick_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="✓"
                    android:textColor="#7FDB9C"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingEnd="8dp"
                android:text="So the alarm can take over the screen."
                android:textColor="#8A93A8"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:letterSpacing="0"
            android:id="@+id/btn_continue"
            style="@style/PrimaryButton"
            android:layout_marginTop="24dp"
            android:text="Continue" />
    </LinearLayout>
</ScrollView>

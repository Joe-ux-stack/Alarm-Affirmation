<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WhyNotYou" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#F2F4F8</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">#F2F4F8</item>
        <item name="colorAccent">#F2F4F8</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:textColorPrimary">#F2F4F8</item>
        <item name="android:colorControlActivated">#F2F4F8</item>
        <item name="android:timePickerStyle">@style/TimePickerDark</item>
        <item name="textAppearanceButton">@style/ButtonText</item>
        <item name="materialButtonStyle">@style/BaseButton</item>
        <item name="android:alertDialogTheme">@style/DialogDark</item>
        <item name="materialAlertDialogTheme">@style/DialogDark</item>
    </style>

    <style name="Theme.WhyNotYou.Fullscreen" parent="Theme.WhyNotYou">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="DialogDark" parent="Theme.MaterialComponents.Dialog">
        <item name="colorPrimary">#F2F4F8</item>
        <item name="colorAccent">#F2F4F8</item>
        <item name="android:background">#0B0D12</item>
        <item name="android:textColorPrimary">#F2F4F8</item>
        <item name="android:textColorSecondary">#7A8294</item>
    </style>

    <style name="TimePickerDark" parent="android:Widget.Material.TimePicker">
        <item name="android:headerBackground">#0B0D12</item>
        <item name="android:numbersBackgroundColor">#15181F</item>
        <item name="android:numbersSelectorColor">#F2F4F8</item>
        <item name="android:numbersTextColor">#F2F4F8</item>
    </style>

    <style name="ButtonText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="BaseButton" parent="Widget.MaterialComponents.Button">
        <item name="android:letterSpacing">0</item>
        <item name="android:textAppearance">@style/ButtonText</item>
    </style>

    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">#F2F4F8</item>
        <item name="android:textColor">#000000</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="OutlineButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#F2F4F8</item>
        <item name="strokeColor">#22262F</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#7A8294</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="SmallPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">#F2F4F8</item>
        <item name="android:textColor">#000000</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#555B68</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="RowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#F2F4F8</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#7A8294</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="NavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="NavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SheetDark" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/SheetShape</item>
        <item name="android:navigationBarColor">#0B0D12</item>
    </style>
    <style name="SheetShape" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">#0B0D12</item>
        <item name="shapeAppearanceOverlay">@style/SheetCorners</item>
    </style>
    <style name="SheetCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
    </style>

    <style name="AmPm">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_pill_outline</item>
        <item name="android:textColor">#7A8294</item>
    </style>

    <style name="PickerCol">
        <item name="android:layout_width">104dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
    </style>
    <style name="PickerLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textColor">#7A8294</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Picker">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">220dp</item>
    </style>
    <style name="Preset">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/bg_pill_outline</item>
        <item name="android:textColor">#F2F4F8</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="BigRoundAmber">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">96dp</item>
        <item name="android:background">@drawable/bg_circle_amber</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="BigRoundOutline">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">96dp</item>
        <item name="android:background">@drawable/bg_circle_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#B8BFCC</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="PresetEdit">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">3</item>
        <item name="android:background">@drawable/bg_pill_outline</item>
        <item name="android:textColor">#F2F4F8</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- Slider: dark 4dp track, white filled part, rounded ends. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical|fill_horizontal">
        <shape android:shape="rectangle"><size android:height="4dp" /><corners android:radius="2dp" /><solid android:color="#2A3550" /></shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle"><size android:height="4dp" /><corners android:radius="2dp" /><solid android:color="#F2F4F8" /></shape>
        </scale>
    </item>
</layer-list>
